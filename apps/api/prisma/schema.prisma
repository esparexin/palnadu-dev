generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  PROJECT_MANAGER
  DEVELOPER
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NOT_QUALIFIED
  ON_HOLD
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStage {
  JUST_AN_IDEA
  EXISTING_BUSINESS
  EXISTING_PRODUCT
  EXISTING_WEBSITE
  MANUAL_PROCESS
  NEED_TECHNICAL_HELP
  OTHER
}

enum RequiredHelp {
  IDEA_VALIDATION
  WEB_APPLICATION
  MOBILE_APPLICATION
  CUSTOM_SOFTWARE
  AUTOMATION
  TECHNICAL_CONSULTING
  MVP_DEVELOPMENT
  NOT_SURE
}

// ─── Models ───────────────────────────────────────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(DEVELOPER)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads  Lead[]          @relation("AssignedLeads")
  blogPosts      BlogPost[]
  projectMembers ProjectMember[]
  notifications  Notification[]

  @@map("users")
}

model Lead {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String
  phone              String?
  company            String?
  problemDescription String
  currentSituation   String?
  projectStage       ProjectStage
  requiredHelp       RequiredHelp
  budget             String?
  additionalInfo     String?
  status             LeadStatus   @default(NEW)
  assignedToId       String?      @db.ObjectId
  assignedTo         User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes              String?
  convertedClientId  String?      @db.ObjectId
  convertedClient    Client?      @relation("ConvertedFromLead", fields: [convertedClientId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

model Client {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  company   String?
  email     String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads       Lead[]      @relation("ConvertedFromLead")
  projects    Project[]
  caseStudies CaseStudy[]

  @@index([email])
  @@map("clients")
}

model Project {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  clientId           String        @db.ObjectId
  client             Client        @relation(fields: [clientId], references: [id])
  description        String?
  status             ProjectStatus @default(PLANNING)
  startDate          DateTime?
  expectedCompletion DateTime?
  technology         String[]
  budget             String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  members ProjectMember[]

  @@index([status])
  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  role      String  @default("DEVELOPER")

  @@unique([projectId, userId])
  @@map("project_members")
}

model Service {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String        @unique
  shortDescription String
  content          String
  icon             String?
  heroImage        String?
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  faqs             Json?
  status           PublishStatus @default(DRAFT)
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@map("services")
}

model CaseStudy {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String        @unique
  clientId       String?       @db.ObjectId
  client         Client?       @relation(fields: [clientId], references: [id])
  problem        String
  solution       String
  technology     String[]
  result         String
  images         String[]
  content        String?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@map("case_studies")
}

model BlogPost {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String        @unique
  // Stable identity of the automation topic this post was generated from.
  // Title/slug are LLM-authored presentation metadata and must NOT be used for
  // identity: the LLM rewords both on every run, so matching on them lets one
  // topic produce many posts.
  //
  // This is the database-level guarantee required by the automation design:
  // one topicKey => at most one post, enforced by a unique index rather than by
  // application checks alone. Legacy rows must be backfilled before the index
  // can be created (see prisma/backfill-topic-key.ts); on MongoDB a unique index
  // also constrains null, so the column is deliberately non-nullable.
  topicKey       String        @unique @map("topic_key")
  // Original topic text as discovered, kept for audit and similarity checks.
  topic          String?
  excerpt        String?
  content        String
  coverImage     String?
  categoryId     String?       @db.ObjectId
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId       String        @db.ObjectId
  author         User          @relation(fields: [authorId], references: [id])
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  publishDate    DateTime?
  status         PublishStatus @default(DRAFT)
  imageMetadata  Json?
  faqData        Json?

  // ── SEO strategy (produced before generation, drives the LLM prompt) ──
  primaryKeyword    String?
  secondaryKeywords String[]
  relatedKeywords   String[]
  longTailKeywords  String[]
  searchIntent      String?
  tags              String[]
  internalLinks     Json?
  externalRefs      Json?

  // ── Generation provenance ──
  llmProvider      String?
  referenceSources String[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([publishDate])
  @@index([searchIntent])
  @@index([primaryKeyword])
  @@map("blog_posts")
  topics BlogTopic[]
}

// ── Durable topic queue ────────────────────────────────────────────────────
// Topics are persisted (not held in memory) so a restart, a second worker, or
// an overlapping cron tick cannot re-generate a topic that is already done or
// in flight. topicKey is the stable identity; the human-readable topic text and
// the LLM-authored title/slug are presentation metadata only.
enum TopicStatus {
  PENDING
  CLAIMED
  COMPLETED
  FAILED
}

model BlogTopic {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  topicKey    String      @unique @map("topic_key")
  topic       String
  categorySlug String
  targetLocation String?
  searchIntent   String?
  primaryKeyword String?
  keywords       String[]
  referenceSources String[]
  status      TopicStatus @default(PENDING)

  // Failure handling: a failed topic is retried, never silently dropped.
  attempts    Int      @default(0)
  lastError   String?
  nextRetryAt DateTime?

  // Optimistic-concurrency lease so two workers cannot claim the same topic.
  claimedAt   DateTime?
  claimedBy   String?

  postId      String?  @unique @db.ObjectId
  post        BlogPost? @relation(fields: [postId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([status, claimedAt])
  @@map("blog_topics")
}

// ── Audit trail ────────────────────────────────────────────────────────────
// One row per generation attempt, written whether the attempt succeeded or not,
// so it is always possible to answer "why was this blog created, and from which
// research signals?".
model BlogGenerationLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topicKey    String?  @map("topic_key")
  topic       String?
  postId      String?  @db.ObjectId

  primaryKeyword    String?
  secondaryKeywords String[]
  searchIntent      String?
  referenceSources  String[]

  generatedTitle String?
  generatedSlug  String?
  llmProvider    String?  @map("llm_provider")

  validationResult String?
  similarityResult String?

  status          PublishStatus?
  publishedUrl    String?   @map("published_url")
  failureReason   String?   @map("failure_reason")
  durationMs      Int?      @map("duration_ms")

  createdAt DateTime @default(now())

  @@index([topicKey])
  @@index([createdAt])
  @@map("blog_generation_logs")
}

model BlogCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

model Media {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("media")
}

model SiteSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}
