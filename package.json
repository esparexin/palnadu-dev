{
  "name": "palnadu-dev",
  "private": true,
  "scripts": {
    "dev": "HOME=/tmp turbo dev",
    "dev:all": "./run.sh dev",
    "build": "pnpm db:generate && HOME=/tmp turbo build",
    "build:all": "./run.sh build",
    "build:api": "pnpm db:generate && pnpm --filter @palnadu/api build",
    "build:web": "pnpm --filter @palnadu/web build",
    "build:admin": "pnpm --filter @palnadu/admin build",
    "lint": "HOME=/tmp turbo lint",
    "test": "HOME=/tmp turbo test",
    "test:api": "pnpm --filter @palnadu/api test",
    "test:web": "pnpm --filter @palnadu/web test",
    "test:admin": "pnpm --filter @palnadu/admin test",
    "clean": "HOME=/tmp turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "search": "node scripts/search-repo.mjs",
    "sleep:prevent": "bash scripts/prevent-sleep.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @palnadu/api db:generate",
    "db:push": "pnpm --filter @palnadu/api db:push",
    "db:migrate": "pnpm --filter @palnadu/api db:migrate",
    "db:seed": "pnpm --filter @palnadu/api db:seed",
    "gate:structure": "node scripts/validate-structure.mjs",
    "gate:contracts": "node scripts/validate-contracts.mjs",
    "gate:circular": "node scripts/check-circular.mjs",
    "gate:secrets": "node scripts/scan-secrets.mjs",
    "gate:routes": "node scripts/validate-routes.mjs",
    "gate:lines": "node scripts/validate-line-counts.mjs",
    "gate:quick": "pnpm gate:lines && pnpm gate:circular && pnpm gate:contracts && pnpm gate:secrets",
    "gate:all": "pnpm gate:lines && pnpm gate:structure && pnpm gate:circular && pnpm gate:contracts && pnpm gate:secrets && pnpm lint && pnpm test && pnpm build && pnpm gate:routes",
    "audit:efficiency": "node scripts/audit-execution-efficiency.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.2.2",
  "devDependencies": {
    "prettier": "^3.3.3",
    "sharp": "^0.35.4",
    "turbo": "^2.3.0"
  }
}
