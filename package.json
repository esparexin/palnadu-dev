{
  "name": "palnadu-dev",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "./run.sh dev",
    "build": "pnpm db:generate && turbo build",
    "build:all": "./run.sh build",
    "build:api": "pnpm db:generate && pnpm --filter @palnadu/api build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @palnadu/api db:generate",
    "db:push": "pnpm --filter @palnadu/api db:push",
    "db:migrate": "pnpm --filter @palnadu/api db:migrate",
    "db:seed": "pnpm --filter @palnadu/api db:seed"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.2.2",
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0"
  }
}
